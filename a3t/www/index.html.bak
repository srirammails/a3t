    </div>
  </div>
</div>

<script>
  // Breakpoint helper used throughout
  const MOBILE_BREAKPOINT = 900;
  function isMobile() { return window.innerWidth <= MOBILE_BREAKPOINT; }

  // Nav scroll chrome
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 12);
  }, { passive: true });

  // ═══ Generalized pinned horizontal scroll for all .pin sections ═══

  class PinSection {
    constructor(section) {
      this.section = section;
      this.stage = section.querySelector('.stage');
      this.slides = section.querySelector('.slides');
      this.dots = Array.from(section.querySelectorAll('.dot'));
      this.progressPill = section.querySelector('.progress-pill');
      this.secNumEl = section.querySelector('.sec-num');
      this.fill = section.querySelector('.bar-fill');
      this.total = this.dots.length;
      this.currentIdx = 0;
      // Percent to translate at t=1: (total-1)/total × 100
      this.translateMax = ((this.total - 1) / this.total) * 100;

      this.dots.forEach(d => {
        d.addEventListener('click', () => this.goto(parseInt(d.dataset.idx)));
      });
    }

    update() {
      // On mobile, slides are stacked vertically — no transform work needed.
      if (isMobile()) {
        // Reset any transform that may have been applied before resize.
        if (this.slides.style.transform) {
          this.slides.style.transform = '';
        }
        if (this.fill && this.fill.style.width) {
          this.fill.style.width = '';
        }
        return;
      }

      const rect = this.section.getBoundingClientRect();
      const navH = 64;
      const viewportAfterNav = window.innerHeight - navH;
      const scrolled = -rect.top + navH;
      const total_distance = this.section.offsetHeight - viewportAfterNav;

      let t = scrolled / total_distance;
      if (t < 0) t = 0;
      if (t > 1) t = 1;

      const translatePercent = t * -this.translateMax;
      this.slides.style.transform = `translate3d(${translatePercent}%, 0, 0)`;

      if (this.fill) this.fill.style.width = (t * 100) + '%';

      const idx = Math.min(this.total - 1, Math.round(t * (this.total - 1)));
      if (idx !== this.currentIdx) {
        this.currentIdx = idx;
        this.dots.forEach((d, i) => d.classList.toggle('active', i === idx));
        if (this.secNumEl) {
          this.secNumEl.textContent = String(idx + 1).padStart(2, '0');
        }
      }
    }

    goto(idx) {
      if (isMobile()) {
        // On mobile, scroll to the slide directly (each slide is its own section).
        const slides = this.slides.querySelectorAll('.slide');
        if (slides[idx]) {
          const rect = slides[idx].getBoundingClientRect();
          const navH = 56; // mobile nav height
          window.scrollTo({ top: window.scrollY + rect.top - navH - 12, behavior: 'smooth' });
        }
        return;
      }
      const navH = 64;
      const viewportAfterNav = window.innerHeight - navH;
      const total_distance = this.section.offsetHeight - viewportAfterNav;
      const targetT = this.total > 1 ? idx / (this.total - 1) : 0;
      const targetScroll = this.section.offsetTop - navH + targetT * total_distance;
      window.scrollTo({ top: targetScroll, behavior: 'smooth' });
    }
  }

  const pinSections = Array.from(document.querySelectorAll('.pin')).map(s => new PinSection(s));

  let ticking = false;
  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        pinSections.forEach(p => p.update());
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    // Immediate update on resize so mobile→desktop transitions apply cleanly.
    pinSections.forEach(p => p.update());
  }, { passive: true });
  pinSections.forEach(p => p.update());

  // ═══ GDPR Cookie Consent ═══

  function getCookieConsent() {
    try {
      var m = document.cookie.match(/(?:^|;\s*)a3t_consent=([^;]*)/);
      return m ? JSON.parse(decodeURIComponent(m[1])) : null;
    } catch(e) { return null; }
  }

  function setCookieConsent(prefs) {
    var val = encodeURIComponent(JSON.stringify(prefs));
    var expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
    document.cookie = 'a3t_consent=' + val + '; expires=' + expires + '; path=/; SameSite=Lax';
  }

  function saveCookieConsent(acceptAll) {
    var prefs = { necessary: true, analytics: acceptAll };
    setCookieConsent(prefs);
    applyConsent(prefs);
    hideCookieBanner();
  }

  function saveCustomConsent() {
    var analytics = document.getElementById('consentAnalytics').checked;
    var prefs = { necessary: true, analytics: analytics };
    setCookieConsent(prefs);
    applyConsent(prefs);
    hideCookieBanner();
  }

  function applyConsent(prefs) {
    if (prefs.analytics) {
      loadOpenReplay();
    }
    // If analytics rejected and tracker already loaded, it stays for this session
    // but won't load on next page visit
  }

  function showCookieBanner() {
    var banner = document.getElementById('cookieBanner');
    // Reset the analytics toggle to current preference
    var existing = getCookieConsent();
    if (existing) {
      document.getElementById('consentAnalytics').checked = existing.analytics;
    }
    banner.classList.add('visible');
  }

  function hideCookieBanner() {
    document.getElementById('cookieBanner').classList.remove('visible');
    document.getElementById('cookieDetails').classList.remove('open');
  }

  function toggleCookieDetails() {
    document.getElementById('cookieDetails').classList.toggle('open');
  }

  // Show banner on first visit (no consent cookie)
  if (!getCookieConsent()) {
    // Slight delay so it doesn't compete with page load
    setTimeout(showCookieBanner, 800);
  }

  // ═══ Legal Modals ═══

  function openLegal(which) {
    var id = which === 'privacy' ? 'privacyModal' : 'termsModal';
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLegal(which) {
    var id = which === 'privacy' ? 'privacyModal' : 'termsModal';
    document.getElementById(id).classList.remove('open');
    // Only restore scroll if the other modal isn't open
    if (!document.querySelector('.legal-overlay.open')) {
      document.body.style.overflow = '';
    }
  }

  // Close modals on overlay click
  document.querySelectorAll('.legal-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        overlay.classList.remove('open');
        if (!document.querySelector('.legal-overlay.open')) {
          document.body.style.overflow = '';
        }
      }
    });
  });

  // Close modals on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.legal-overlay.open').forEach(function(m) {
        m.classList.remove('open');
      });
      document.body.style.overflow = '';
    }
  });

  // Install command copy
  const cmd = document.getElementById('installCmd');
  if (cmd) {
    cmd.addEventListener('click', () => {
      const text = cmd.querySelector('.cmd-text');
      if (text && navigator.clipboard) {
        navigator.clipboard.writeText(text.textContent.trim());
        const original = text.textContent;
        text.textContent = '✓ copied';
        setTimeout(() => { text.textContent = original; }, 1200);
      }
    });
  }
</script>

</body>
</html>
