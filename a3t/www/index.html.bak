<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>A3T — Open Source AI Agent Platform | Build, Run & Scale AI Agents on Kubernetes</title>
<meta name="description" content="A3T is an open-source AI agent platform built on CNCF Serverless Workflow. Build, orchestrate, and deploy AI agents as Kubernetes pods with built-in memory, tools, and a visual canvas." />
<meta name="keywords" content="AI agent platform, AI agents, agent orchestration, agent infrastructure, Kubernetes AI agents, CNCF serverless workflow, open source AI platform, agent runtime, agent memory database, LLM agents, autonomous agents, AI workflow automation" />
<link rel="canonical" href="https://a3t.io/" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://a3t.io/" />
<meta property="og:title" content="A3T — Open Source AI Agent Platform" />
<meta property="og:description" content="Build, orchestrate, and deploy AI agents on Kubernetes. Standards-based runtime with built-in memory, tools, and a visual canvas." />
<meta property="og:site_name" content="A3T" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="A3T — Open Source AI Agent Platform" />
<meta name="twitter:description" content="Build, orchestrate, and deploy AI agents on Kubernetes. Standards-based runtime with built-in memory, tools, and a visual canvas." />

