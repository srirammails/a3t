<section class="pin sec-b" id="sec-b" style="height: 500vh; --slides: 5;">
  <div class="stage">
    <div class="spine"><span class="spine-label">For Developers</span></div>

    <div class="progress-pill">
      <span class="num sec-num">01</span>
      <span>/</span>
      <span>05</span>
      <span>— open source</span>
