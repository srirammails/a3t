              </g>

              <!-- BSL 2.0 badge floating top-right of laptop -->
              <g transform="translate(306, 35)">
                <rect x="0" y="0" width="96" height="28" rx="14" class="ill-fill-bg" stroke="#d9d4c6" stroke-width="1"/>
                <circle cx="18" cy="14" r="6" class="ill-fill-ok-bg" stroke="#23987f" stroke-width="1"/>
                <path d="M 15 14 L 17.5 16.5 L 22 12" stroke="#23987f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <text x="30" y="18" class="ill-text" style="font-size: 9px; fill: var(--ok-ink); font-weight: 600;">BSL 2.0</text>
              </g>

              <!-- Download/arrow indicator on left -->
              <g transform="translate(18, 120)">
                <text x="0" y="0" class="ill-text" style="font-size: 8px;" transform="rotate(-90 0 0)">LOCAL MACHINE</text>
              </g>

              <!-- Signal lines showing "offline OK" -->
              <g opacity="0.55">
                <text x="50" y="320" class="ill-text" style="font-size: 8px;">NO CLOUD CALL-HOME</text>
                <text x="50" y="332" class="ill-text" style="font-size: 8px; fill: var(--ok-ink);">→ RUNS COMPLETELY OFFLINE</text>
              </g>

              <!-- Right side: offline icon -->
              <g transform="translate(340, 310)">
                <circle cx="20" cy="20" r="18" class="ill-fill-ivory" stroke="#d9d4c6" stroke-width="1"/>
                <path d="M 8 18 Q 20 28, 32 18" fill="none" stroke="#23987f" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M 12 22 Q 20 30, 28 22" fill="none" stroke="#23987f" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="20" cy="28" r="1.5" class="ill-fill-ok"/>
                <text x="-4" y="55" class="ill-text" style="font-size: 8px;">LOCAL WIFI OK</text>
              </g>

              <!-- Top label -->
              <text x="50" y="40" class="ill-text-serif" style="font-size: 12px;">Your dev machine</text>
