              <div class="trust-row">
                <div class="ti">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 8l3 3 7-7"/></svg>
                  BSL 2.0 license
                </div>
                <div class="sep"></div>
                <div class="ti">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 8l3 3 7-7"/></svg>
                  Docker-native
                </div>
                <div class="sep"></div>
                <div class="ti">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 8l3 3 7-7"/></svg>
                  CNCF SWF 1.0
                </div>
              </div>
            </div>

            <!-- Local-first illustration: laptop with a Docker container holding a cluster -->
            <svg class="hero-art" viewBox="0 0 440 420" xmlns="http://www.w3.org/2000/svg">
              <defs>
