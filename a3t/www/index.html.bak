                  <circle cx="124" cy="14" r="3" class="ill-fill-ok ill-pulse"/>
                  <text x="10" y="33" class="ill-text" style="font-size: 8px;">RECONCILE LOOP · OK</text>
                </g>

                <g transform="translate(190, 182)">
                  <rect x="0" y="0" width="140" height="42" rx="6" class="ill-fill-bg" stroke="#d9d4c6" stroke-width="1"/>
