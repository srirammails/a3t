---
import { render } from 'astro:content';
import Post from '../layouts/Post.astro';
import BookDemo from '../components/BookDemo.astro';
import TryIt from '../components/TryIt.astro';
import Video from '../components/Video.astro';
import Audio from '../components/Audio.astro';
import { getPosts } from '../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		// Up to three other posts, preferring ones that share a tag.
		props: {
			post,
			related: posts
				.filter((p) => p !== post)
				.sort((a, b) => Number(b.data.tags.some((t) => post.data.tags.includes(t))) - Number(a.data.tags.some((t) => post.data.tags.includes(t))))
				.slice(0, 3),
		},
	}));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---
<Post post={post} related={related}>
	<Content components={{ BookDemo, TryIt, Video, Audio }} />
</Post>
