---
import { url } from '../lib/url';
// Post cover: the post's image, or a generated panel in the tone of its first tag.
// Video/audio posts get a play mark so they read as media in the grid.
import { toneFor } from '../consts';

interface Props {
	title: string;
	tag?: string;
	image?: string;
	imageAlt?: string;
	media?: 'video' | 'audio';
	eager?: boolean;
}
const { title, tag, image, imageAlt, media, eager = false } = Astro.props;
---
<div class:list={['cover', `tone-${toneFor(tag)}`, { generated: !image }]}>
	{image ? (
		<img src={url(image)} alt={imageAlt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
	) : (
		<>
			<span class="cover-mark">A3T · {tag ?? 'blog'}</span>
			<span class="cover-label" aria-hidden="true">{title}</span>
		</>
	)}
	{media && (
		<span class="cover-play" aria-hidden="true">
			{media === 'video'
				? <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"/></svg>
				: <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v6H4zM17 14h3v6h-3z"/></svg>}
		</span>
	)}
</div>
