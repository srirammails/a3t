---
// Inline link card into the docs, for MDX posts: <TryIt href="https://docs.a3t.io/concepts/memory/">Memory concepts</TryIt>
interface Props {
	href: string;
	label?: string;
}
const { href, label = 'Try it in the docs' } = Astro.props;
---
<a class="try-it" href={href}>
	<span class="ico" aria-hidden="true">
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 2.5h7l3 3v8H3z M10 2.5v3h3 M5.5 8.5h5 M5.5 11h3.5"/></svg>
	</span>
	<span class="txt"><small>{label}</small><slot /></span>
	<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
</a>
