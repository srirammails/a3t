---
import { url } from '../lib/url';
import '../styles/global.css';
import { BLOG_TITLE, DEFAULT_OG_IMAGE } from '../consts';

export interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	published?: Date;
	author?: string;
}
const { title, description, image, imageAlt, type = 'website', published, author } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : DEFAULT_OG_IMAGE;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#faf9f6" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
<link rel="icon" href={url('favicon.ico')} />
<link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="sitemap" href={url('sitemap-index.xml')} />

<!-- Open Graph: LinkedIn builds the share card from these -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="A3T" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{author && <meta name="author" content={author} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;450;500;550;600&display=swap" rel="stylesheet" />
