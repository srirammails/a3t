---
import { url } from '../lib/url';
// Video or audio player. YouTube loads as a thumbnail and only fetches the player on click.
interface Props {
	type: 'video' | 'audio';
	src: string;
	title: string;
	poster?: string;
	duration?: string;
	compact?: boolean;
}
const { type, src, title, poster, compact = false } = Astro.props;

const isFile = /\.(mp4|webm|mov|m4v|mp3|m4a|aac|ogg|oga|opus|wav)(\?|$)/i.test(src);
const yt = src.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/)?.[1];
const vimeo = src.match(/vimeo\.com\/(?:video\/)?(\d+)/)?.[1];
const kind = isFile ? 'file' : yt ? 'youtube' : vimeo ? 'vimeo' : 'embed';
const embedSrc = vimeo ? `https://player.vimeo.com/video/${vimeo}?dnt=1` : src;
const fileSrc = url(src);
const posterSrc = poster && url(poster);
---
<figure class:list={['media', `media-${type}`, `media-${kind}`, { compact }]}>
	{kind === 'youtube' && (
		<button type="button" class="yt-facade" data-yt={yt} aria-label={`Play video: ${title}`}>
			<img src={`https://i.ytimg.com/vi/${yt}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
			<span class="play" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"/></svg></span>
		</button>
	)}
	{kind === 'file' && type === 'video' && (
		<video controls preload="metadata" playsinline poster={posterSrc} src={fileSrc}><a href={fileSrc}>Download the video</a></video>
	)}
	{kind === 'file' && type === 'audio' && (
		<div class="audio-card">
			<span class="audio-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg></span>
			<span class="audio-title">{title}</span>
			<audio controls preload="none" src={fileSrc}><a href={fileSrc}>Download the audio</a></audio>
		</div>
	)}
	{(kind === 'vimeo' || kind === 'embed') && (
		<iframe src={embedSrc} title={title} loading="lazy" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
	)}
</figure>

<script>
	document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) => {
		btn.addEventListener('click', () => {
			const f = document.createElement('iframe');
			f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
			f.title = btn.getAttribute('aria-label') ?? 'Video';
			f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
			f.allowFullscreen = true;
			btn.replaceWith(f);
		}, { once: true });
	});
</script>
